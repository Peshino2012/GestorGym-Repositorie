generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String?
  passwordHash       String
  role               Role     @default(OWNER)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  // Marks the Cauccen-managed account kept on every gym (see onboarding) so
  // its own client — also an OWNER, symmetric permissions otherwise — can't
  // deactivate, delete, demote, or lock it out by changing its email/
  // password. Sets nowhere in the UI; only via direct DB access.
  protected          Boolean  @default(false)
  canAccessClasses   Boolean  @default(true)
  canAccessHorarios  Boolean  @default(true)
  canAccessPlanes    Boolean  @default(true)
  canAccessCheckin   Boolean  @default(true)
}

enum Role {
  OWNER
  STAFF
}

model Plan {
  id           String       @id @default(cuid())
  name         String
  price        Int
  billingCycle BillingCycle @default(MONTHLY)
  active       Boolean      @default(true)
  featured     Boolean      @default(false)
  features     String?
  members      Member[]
  payments     Payment[]
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model Member {
  id       String       @id @default(cuid())
  name     String
  email    String?
  phone    String
  dni      String?      @unique
  joinedAt DateTime     @default(now())
  status   MemberStatus @default(ACTIVE)
  photoUrl String?

  emergencyName  String?
  emergencyPhone String?
  emergencyNotes String?

  riskDismissedUntil DateTime?
  archivedAt          DateTime?

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  payments Payment[]
  checkIns CheckIn[]
  bookings Booking[]
  messages MessageLog[]
}

enum MemberStatus {
  ACTIVE
  OVERDUE
  INACTIVE
}

model Payment {
  id        String        @id @default(cuid())
  amount    Int
  dueDate   DateTime
  paidAt    DateTime?
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  // When this payment is marked paid, the next cycle's payment is created
  // automatically and linked back here — lets undoMarkPaid clean it up.
  renewedFromId String?  @unique
  renewedFrom   Payment? @relation("PaymentRenewal", fields: [renewedFromId], references: [id])
  renewedTo     Payment? @relation("PaymentRenewal")

  // Set when a "Cobrar con Mercado Pago" link is generated for this cobro.
  // mpPaymentId is MP's own id for the payment once it's actually paid —
  // unique so the webhook can never apply the same MP payment twice, even
  // if MP sends the same notification more than once (it does).
  mpPreferenceId String?
  mpPaymentId    String? @unique
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model CheckIn {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model GymClass {
  id          String  @id @default(cuid())
  name        String
  instructor  String
  dayOfWeek   Int
  startTime   String
  durationMin Int
  capacity    Int
  description String?
  icon        String  @default("dumbbell")
  showOnSite  Boolean @default(false)

  bookings Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  status    BookingStatus @default(BOOKED)
  createdAt DateTime      @default(now())

  classId String
  class   GymClass @relation(fields: [classId], references: [id])

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([classId, memberId])
}

enum BookingStatus {
  BOOKED
  WAITLIST
  CANCELLED
}

model MessageLog {
  id      String      @id @default(cuid())
  type    MessageType
  content String
  sentAt  DateTime    @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

enum MessageType {
  PAYMENT_REMINDER
  RETENTION_ALERT
}

model GymSettings {
  id              String  @id @default("main")
  name            String  @default("Mi Gimnasio")
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  // The gym's own public marketing site (a separate deployment/repo from
  // this admin panel) — lets the panel show a direct link to it instead
  // of the owner having to keep the URL somewhere themselves.
  publicSiteUrl   String?
  // HSL triplet ("145 84% 19%", no hsl()/commas — same format as the
  // --primary custom property it overrides) sampled from the gym's own
  // logo, so their panel reads as their own product instead of visibly
  // "powered by Cauccen". Null falls back to Cauccen's own blue/teal.
  themeColor      String?
  // The gym's own Mercado Pago credentials ("Credenciales de producción"
  // in their MP developer panel), pasted in from Configuración (OWNER-only,
  // same as the rest of that page). Every "Cobrar con Mercado Pago" link
  // and the webhook that confirms it read these, never a shared platform
  // account, so a socio's payment lands in that gym's own MP balance.
  mercadoPagoAccessToken  String?
  mercadoPagoWebhookSecret String?
  checkinEnabled  Boolean @default(false)
  classesEnabled  Boolean @default(false)
  horariosEnabled Boolean @default(false)
  planesEnabled   Boolean @default(false)
}

model Trainer {
  id        String   @id @default(cuid())
  name      String
  specialty String?
  bio       String?
  photoUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  createdAt DateTime @default(now())
}

model ScheduleBlock {
  id         String @id @default(cuid())
  title      String
  hoursLabel String
  icon       String @default("sun")
  order      Int    @default(0)

  entries ScheduleEntry[]
}

model ScheduleEntry {
  id    String @id @default(cuid())
  time  String
  name  String
  order Int    @default(0)

  blockId String
  block   ScheduleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}
