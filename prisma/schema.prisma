generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String?
  passwordHash       String
  role               Role     @default(OWNER)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  canAccessClasses   Boolean  @default(true)
  canAccessHorarios  Boolean  @default(true)
  canAccessPlan      Boolean  @default(true)
  canAccessPlanes    Boolean  @default(true)
  canAccessCheckin   Boolean  @default(true)
}

enum Role {
  OWNER
  STAFF
}

model Plan {
  id           String       @id @default(cuid())
  name         String
  price        Int
  billingCycle BillingCycle @default(MONTHLY)
  active       Boolean      @default(true)
  featured     Boolean      @default(false)
  features     String?
  members      Member[]
  payments     Payment[]
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model Member {
  id       String       @id @default(cuid())
  name     String
  email    String?
  phone    String
  dni      String?      @unique
  joinedAt DateTime     @default(now())
  status   MemberStatus @default(ACTIVE)
  photoUrl String?

  emergencyName  String?
  emergencyPhone String?
  emergencyNotes String?

  riskDismissedUntil DateTime?
  archivedAt          DateTime?

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  payments Payment[]
  checkIns CheckIn[]
  bookings Booking[]
  messages MessageLog[]
}

enum MemberStatus {
  ACTIVE
  OVERDUE
  INACTIVE
}

model Payment {
  id        String        @id @default(cuid())
  amount    Int
  dueDate   DateTime
  paidAt    DateTime?
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  // When this payment is marked paid, the next cycle's payment is created
  // automatically and linked back here — lets undoMarkPaid clean it up.
  renewedFromId String?  @unique
  renewedFrom   Payment? @relation("PaymentRenewal", fields: [renewedFromId], references: [id])
  renewedTo     Payment? @relation("PaymentRenewal")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model CheckIn {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model GymClass {
  id          String  @id @default(cuid())
  name        String
  instructor  String
  dayOfWeek   Int
  startTime   String
  durationMin Int
  capacity    Int
  description String?
  icon        String  @default("dumbbell")
  showOnSite  Boolean @default(false)

  bookings Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  status    BookingStatus @default(BOOKED)
  createdAt DateTime      @default(now())

  classId String
  class   GymClass @relation(fields: [classId], references: [id])

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([classId, memberId])
}

enum BookingStatus {
  BOOKED
  WAITLIST
  CANCELLED
}

model MessageLog {
  id      String      @id @default(cuid())
  type    MessageType
  content String
  sentAt  DateTime    @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

enum MessageType {
  PAYMENT_REMINDER
  RETENTION_ALERT
}

model GymSettings {
  id              String  @id @default("main")
  name            String  @default("Mi Gimnasio")
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  checkinEnabled  Boolean @default(false)
  classesEnabled  Boolean @default(false)
  horariosEnabled Boolean @default(false)
  planesEnabled   Boolean @default(true)
}

model Trainer {
  id        String   @id @default(cuid())
  name      String
  specialty String?
  bio       String?
  photoUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  createdAt DateTime @default(now())
}

model ScheduleBlock {
  id         String @id @default(cuid())
  title      String
  hoursLabel String
  icon       String @default("sun")
  order      Int    @default(0)

  entries ScheduleEntry[]
}

model ScheduleEntry {
  id    String @id @default(cuid())
  time  String
  name  String
  order Int    @default(0)

  blockId String
  block   ScheduleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}
